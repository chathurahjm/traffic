{
  "name": "ga-traffic-simulator",
  "version": "1.0.0",
  "description": "Realistic traffic simulator for Google Analytics using Puppeteer",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "auth": "node youtube/save_auth.js",
    "monitor": "node youtube/monitor.js",
    "vpngate": "node youtube/vpngate.js",
    "monitor:vpngate": "node youtube/vpngate.js --export /tmp/vpngate.ovpn && node youtube/monitor.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "playwright": "^1.49.1",
    "puppeteer-core": "^24.2.1",
    "uuid": "^11.0.5"
  }
}
